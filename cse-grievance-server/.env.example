# MongoDB
MONGODB_URI=mongodb://localhost:27017/cse_grievance

# JWT
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Server
PORT=5000
NODE_ENV=development

# Frontend origin (CORS)
CLIENT_URL=http://localhost:5173

# Institutional email domains (comma-separated)
INSTITUTIONAL_DOMAINS=ruet.ac.bd

# Upload limits
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

# Email notifications (leave SMTP_* empty to use console/dev mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CSE Grievance System <no-reply@cse.ruet.ac.bd>

# Math captcha (set to false to disable on login)
CAPTCHA_ENABLED=true
